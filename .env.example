# Kopieren nach .env (wird nicht ins Repo eingecheckt):  cp .env.example .env
# Die Werte hier reichen für den Laptop. Auf dem Server alle ändern.

# Geheimer Schlüssel für Sessions und Signaturen. Auf dem Server neu erzeugen:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=nur-lokal-bitte-auf-dem-server-ersetzen

# Kommagetrennt. Auf dem Server z. B.: jonasduelberg.com,www.jonasduelberg.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Kommagetrennt, mit Schema. Auf dem Server z. B.: https://www.jonasduelberg.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# true erzwingt HTTPS (Weiterleitung, sichere Cookies, HSTS). Erst auf dem Server mit Zertifikat.
DJANGO_SECURE_SSL=false

# Adresse der Seite, wie sie in Mails aus dem Wagtail-Admin steht.
WAGTAILADMIN_BASE_URL=http://localhost:8080

# Datenbank (der Postgres-Container legt sie beim ersten Start mit diesen Werten an)
POSTGRES_DB=jonaswebsite
POSTGRES_USER=jonaswebsite
POSTGRES_PASSWORD=nur-lokal
POSTGRES_HOST=db
POSTGRES_PORT=5432
